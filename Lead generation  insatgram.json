    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\n\nconst results = data.results || data.organicResults || [];\n\nreturn results.map(item => {\n  const followersText = item.displayedUrl || \"\";\n  const match = followersText.match(/([\\d,.]+)\\s*(k|m)?/i);\n\n  let followers = null;\n\n  if (match) {\n    followers = Number(match[1].replace(/,/g, \"\"));\n    if (match[2]?.toLowerCase() === \"k\") followers *= 1000;\n    if (match[2]?.toLowerCase() === \"m\") followers *= 1000000;\n  }\n\n  return {\n    json: {\n      name: item.title || \"\",\n      username: item.websiteTitle || item.username || \"\",\n      handle: item.url || \"\",\n      description: item.description || \"\",\n      followers: followers\n    }\n  };\n});\n"
      },
